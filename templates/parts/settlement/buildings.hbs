<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="ss-grid-2col">
    {{#each actor.system.buildings as |building id|}}
      <div class="building">
        <h3 class="building-header">
          {{building.name}}
          {{#if ../editable}}
            <div>
              <label class="remove-building" data-action="removeBuilding" data-uuid="{{building.uuid}}" title="{{localize 'settlement-sheets.RemoveBuilding'}}">
                <i class="fas fa-trash"></i>
              </label>
              <label class="open-building" data-action="openBuilding" data-uuid="{{building.uuid}}" title="{{localize 'settlement-sheets.EditBuilding'}}">
                <i class="fas fa-cog"></i>
              </label>
            </div>
          {{/if}}
        </h3>
        <div>{{{building.system.description}}}</div>
        {{#ifeq permissions 'owner'}}
          <div>{{{building.system.benefits}}}</div>
        {{/ifeq}}
      </div>
    {{/each}}
    {{#ifeq permissions 'owner'}}
      <div class="building">
        <div class="add-building" data-action="addBuilding">
          <h3>
            {{localize 'settlement-sheets.AddNewBuilding'}}
          </h3>
          <div>{{localize 'settlement-sheets.AddNewBuildingHint'}}</div>
        </div>
      </div>
    {{/ifeq}}
  </div>
</section>
