<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="description">
    <h3 class="field-title">{{localize 'settlement-sheets.SettlementDescription'}}</h3>
    <prose-mirror name="system.description" value="{{description}}"
        toggled="true" compact="true">
        {{{description}}}
    </prose-mirror>
  </div>
  <div class="flexrow">
    <div class="influential-people">
      <h3 class="field-title">{{localize 'settlement-sheets.InfluentialPeople'}}</h3>
      <prose-mirror name="system.influentialPeople" value="{{influentialPeople}}"
          toggled="true" compact="true">
          {{{influentialPeople}}}
      </prose-mirror>
    </div>
  </div>
</section>
